# Copy to .env and fill in values

# MongoDB connection string (Atlas or local)
# Example Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/tripplanner?retryWrites=true&w=majority
MONGODB_URI=

# Secret for signing JWT tokens (use a long random string in production)
JWT_SECRET=

# Optional: comma-separated allowed browser origins (defaults to Vite dev URL)
# CLIENT_ORIGIN=http://localhost:5173

# Optional: API port (default 5000)
# PORT=5000
